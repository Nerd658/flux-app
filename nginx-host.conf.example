# ==============================================================================
# Configuration Nginx pour le serveur hote (Reverse Proxy HTTP direct sur IP)
# Emplacement suggere : /etc/nginx/sites-available/flux-app.conf
# Activation : ln -s /etc/nginx/sites-available/flux-app.conf /etc/nginx/sites-enabled/
# Verification : nginx -t && systemctl reload nginx
# ==============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name _; # Repond sur l'adresse IP directe du serveur ou n'importe quel hostname

    # Taille maximale des requetes (pour les uploads et les documents PDF)
    client_max_body_size 25M;

    # En-tetes de securite
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # 1. Routage vers l'API Backend (FastAPI / Gunicorn conteneurise)
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Gestion des cookies et headers HTTP
        proxy_pass_header Set-Cookie;
        proxy_buffering off;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }

    # 2. Routage vers le Frontend (React SPA Nginx conteneurise)
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ==============================================================================
