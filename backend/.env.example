# Connexion MySQL (XAMPP) : utilisateur dédié, jamais root en dehors du dev
DATABASE_URL=mysql+pymysql://flux_user:CHANGE_ME@127.0.0.1:3306/flux_db?charset=utf8mb4

# Secret de signature des JWT : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME

# Clé maître qui chiffre les clés privées Ed25519 des validateurs.
# Ne plus la modifier une fois l'appli utilisée : sinon chaque validateur reçoit une nouvelle clé de signature
# (géré automatiquement, anciennes signatures toujours vérifiables, mais à éviter).
KEY_ENCRYPTION_SECRET=CHANGE_ME

# Origine autorisée du frontend React (CORS strict)
CORS_ORIGINS=["http://localhost:5173"]

# Mot de passe des comptes fictifs créés par le seed (dev uniquement)
SEED_PASSWORD=CHANGE_ME
